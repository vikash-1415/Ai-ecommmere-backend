# Backend server port
PORT=5000

# Allowed frontend origins (comma-separated)
CLIENT_URL=http://localhost:5173,https://ai-ecommmere.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB connection string; replace with your own Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/weathercart

# Replace with a long, random secret before deploying
JWT_SECRET=replace-with-a-long-random-secret-before-deploying

# Required on the first seed run. Use at least 12 characters.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin@weathercart.com

# SMTP: verification and order emails are enabled when host, user and password are set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Leave blank to send from SMTP_USER; Gmail requires any alternate sender to be a verified alias.
# Remove spaces from Gmail app passwords when setting SMTP_PASS.
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=true

# Optional: OpenWeatherMap key; Open-Meteo is used when this is blank
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
